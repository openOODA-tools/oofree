// # Kernel Memory Info Procfs Parser
//
// Logline: Ingests and parses /proc/meminfo text streams into strongly typed memory statistics.
//
// Setup: Pure string scanning and key extraction without ambient file authority.
//
// Beats:
//   1. Split raw stream into individual line records.
//   2. Extract colon-delimited key names and numeric values.
//   3. Match known kernel memory statistics into typed MemStats fields.
//   4. Provide helper to parse integer sequences from string buffers.

import "core/mem_entry.oo";

pub fn split_text_lines(text: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(text);
    if n == 0 {
        return lines;
    }

    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(text, i);
        if b == 10 { // newline \n
            let mut end: Int = i;
            if end > start && byte_at(text, end - 1) == 13 { // \r
                end = end - 1;
            }
            lines = list_push(lines, str_slice(text, start, end));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        let mut end: Int = n;
        if end > start && byte_at(text, end - 1) == 13 {
            end = end - 1;
        }
        lines = list_push(lines, str_slice(text, start, end));
    }
    return lines;
}

pub fn parse_int_digits(s: String) -> Int {
    let mut val: Int = 0;
    let n: Int = chars_len(s);
    let mut has_digit: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b >= 48 && b <= 57 {
            val = (val * 10) + (b - 48);
            has_digit = true;
        } else if has_digit {
            break;
        }
        i = i + 1;
    }
    return val;
}

pub fn parse_meminfo_stream(stream: String) -> MemStats {
    let mut stats: MemStats = empty_mem_stats();
    let lines: List[String] = split_text_lines(stream);
    let num_lines: Int = list_len(lines);
    let mut i: Int = 0;

    while i < num_lines {
        let line: String = list_get(lines, i);
        let n: Int = chars_len(line);
        let mut colon_pos: Int = -1;
        let mut c_idx: Int = 0;

        while c_idx < n {
            if byte_at(line, c_idx) == 58 { // ':'
                colon_pos = c_idx;
                break;
            }
            c_idx = c_idx + 1;
        }

        if colon_pos > 0 {
            let key: String = str_slice(line, 0, colon_pos);
            let val_str: String = str_slice(line, colon_pos + 1, n);
            let val_num: Int = parse_int_digits(val_str);

            if key == "MemTotal" {
                stats.mem_total_kb = val_num;
            } else if key == "MemFree" {
                stats.mem_free_kb = val_num;
            } else if key == "MemAvailable" {
                stats.mem_avail_kb = val_num;
            } else if key == "Buffers" {
                stats.buffers_kb = val_num;
            } else if key == "Cached" {
                stats.cached_kb = val_num;
            } else if key == "SReclaimable" {
                stats.srecl_kb = val_num;
            } else if key == "Shmem" {
                stats.shmem_kb = val_num;
            } else if key == "SwapTotal" {
                stats.swap_total_kb = val_num;
            } else if key == "SwapFree" {
                stats.swap_free_kb = val_num;
            } else if key == "CommitLimit" {
                stats.commit_limit_kb = val_num;
            } else if key == "Committed_AS" {
                stats.committed_as_kb = val_num;
            } else if key == "Active(anon)" {
                stats.active_anon_kb = val_num;
            } else if key == "Inactive(anon)" {
                stats.inactive_anon_kb = val_num;
            } else if key == "Active(file)" {
                stats.active_file_kb = val_num;
            } else if key == "Inactive(file)" {
                stats.inactive_file_kb = val_num;
            } else if key == "Dirty" {
                stats.dirty_kb = val_num;
            } else if key == "Slab" {
                stats.slab_kb = val_num;
            }
        }

        i = i + 1;
    }

    return stats;
}
