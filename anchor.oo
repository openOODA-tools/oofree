// # oofree Root Anchor
//
// Logline: Top-level anchor uniting core, render, and ipc subsystems into a sovereign test suite.
//
// Setup: Exports subsystem anchors and runs cross-cutting verification tests.
//
// Beats:
//   1. Re-export core subsystem anchor.
//   2. Re-export render subsystem anchor.
//   3. Re-export ipc subsystem anchor.
//   4. Execute all subsystem verification suites.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    let mut ok: Bool = true;
    if !run_core_tests() {
        ok = false;
    }
    if !run_render_tests() {
        ok = false;
    }
    if !run_ipc_tests() {
        ok = false;
    }
    return ok;
}
